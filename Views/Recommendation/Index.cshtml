@model IEnumerable<junimo_v3.Models.GameRecommendation>

@{
    ViewData["Title"] = "Recommendations";
}

<div class="container mt-4">
    <h1 class="text-white mb-4">
        <i class="bi bi-lightbulb"></i> Recommended For You
    </h1>
    
    <p class="text-white mb-4">
        Based on your gaming preferences and purchase history, we think you'll enjoy these games:
    </p>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-white">
            <h4>No recommendations yet!</h4>
            <p>Start purchasing games to get personalized recommendations based on your gaming preferences.</p>
            <a asp-controller="Game" asp-action="Index" class="btn btn-primary">Browse All Games</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var recommendation in Model)
            {
                <div class="col-md-4 col-sm-6 mb-4">
                    <div class="card h-100 bg-dark text-white">
                        @if (!string.IsNullOrEmpty(recommendation.ImageUrl))
                        {
                            <img src="@recommendation.ImageUrl" class="card-img-top" alt="@recommendation.GameTitle" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="bi bi-controller" style="font-size: 3rem;"></i>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@recommendation.GameTitle</h5>
                            
                            @if (recommendation.Genres != null && recommendation.Genres.Any())
                            {
                                <div class="mb-2">
                                    @foreach (var genre in recommendation.Genres)
                                    {
                                        <span class="badge bg-primary me-1">@genre</span>
                                    }
                                </div>
                            }
                            
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-success fw-bold">$@recommendation.Price.ToString("F2")</span>
                                    @if (recommendation.Score > 0)
                                    {
                                        <span class="badge bg-info">
                                            @((recommendation.Score * 100).ToString("F0"))% Match
                                        </span>
                                    }
                                </div>
                                <a asp-controller="Game" asp-action="GameDetails" asp-route-id="@recommendation.GameId" class="btn btn-primary w-100">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .card {
        transition: transform 0.2s;
        border: 1px solid #495057;
    }
    
    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
    }
</style>
